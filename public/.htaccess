# =============================================================================
# Public .htaccess  —  Front Controller routing
# =============================================================================
#
# ErrorDocument — Apache-level errors (ก่อน PHP / เซิร์ฟเวอร์ล้ม)
# DocumentRoot ต้องชี้ที่โฟลเดอร์ public (ถ้าไม่ใช่ แก้ path ให้มี prefix โฟลเดอร์โปรเจกต์)
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # base path ปรับอัตโนมัติเมื่อใช้ใน subfolder
    # ถ้ามีไฟล์/โฟลเดอร์จริง ให้เข้าได้
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ส่งทุกอย่างที่เหลือไปที่ index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Cache assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg            "access plus 30 days"
    ExpiresByType image/png             "access plus 30 days"
    ExpiresByType image/webp            "access plus 30 days"
    ExpiresByType image/svg+xml         "access plus 30 days"
    ExpiresByType image/gif             "access plus 30 days"
    ExpiresByType font/woff2            "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Cache-Control for static assets
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml text/xml image/svg+xml font/woff2
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

AddDefaultCharset UTF-8

Options -Indexes
ServerSignature Off

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options        "SAMEORIGIN"
    Header set Referrer-Policy        "strict-origin-when-cross-origin"
</IfModule>
